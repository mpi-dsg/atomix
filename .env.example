# ===========================================
# ATOMIX ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then load with:
#   source .env

# -------------------------------------------
# Data Directories
# -------------------------------------------
# Root directory for all workload datasets (default: ./data relative to project)
# All workload data will be stored under this directory
DATA_ROOT=./data

# WebArena dataset location (default: $DATA_ROOT/webarena)
WEBARENA_DATA_DIR=${DATA_ROOT}/webarena

# SWE-bench dataset cache location (default: $DATA_ROOT/swebench)
SWE_BENCH_DATA_DIR=${DATA_ROOT}/swebench

# OSWorld dataset location (default: $DATA_ROOT/osworld)
OSWORLD_DATA_DIR=${DATA_ROOT}/osworld

# Taubench dataset location (default: $DATA_ROOT/tau2-bench)
TAUBENCH_DIR=${DATA_ROOT}/tau2-bench

# TheAgentCompany location (default: $DATA_ROOT/theagentcompany)
THEAGENTCOMPANY_DIR=${DATA_ROOT}/theagentcompany

# -------------------------------------------
# API Keys - LLM Providers
# -------------------------------------------
# Anthropic API key (for OSWorld real VM agent with Claude)
ANTHROPIC_API_KEY=

# OpenAI API key (for GAIA workload tools)
OPENAI_API_KEY=

# -------------------------------------------
# API Keys - External Services (Optional)
# -------------------------------------------
# Tavily API key (for GAIA web search tool)
TAVILY_API_KEY=

# HuggingFace token (for faster dataset downloads, avoids rate limits)
HF_TOKEN=

# -------------------------------------------
# OSWorld Real VM Configuration (Optional)
# -------------------------------------------
# Path to Ubuntu VM image for real desktop automation
OSWORLD_VM_IMAGE=

# VM resources
OSWORLD_VM_MEMORY_MB=4096
OSWORLD_VM_CPUS=2

# -------------------------------------------
# WebArena Service URLs
# -------------------------------------------
# Required when running WebArena with real services (WEBARENA_USE_REAL_ENV=1)
# These URLs should point to your WebArena Docker services
REDDIT=http://127.0.0.1:9999
SHOPPING=http://127.0.0.1:7770
SHOPPING_ADMIN=http://127.0.0.1:7780/admin
GITLAB=http://127.0.0.1:8023
WIKIPEDIA=http://127.0.0.1:8888/wikipedia_en_all_maxi_2022-05/A/User:The_other_Kiwix_guy/Landing
MAP=http://127.0.0.1:3000
HOMEPAGE=http://127.0.0.1:4399

# -------------------------------------------
# WebArena Configuration (Optional)
# -------------------------------------------
# Set to 1 to use real browser instead of simulated
WEBARENA_USE_REAL_ENV=0

# -------------------------------------------
# Debug/Development (Optional)
# -------------------------------------------
# Enable verbose logging
ATOMIX_DEBUG=0

# Effect log output path
ATOMIX_EFFECT_LOG_PATH=
